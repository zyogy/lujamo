{
  "name": "lujamo-site",
  "version": "0.1.0",
  "description": "Lujamo – static multilingual website (Astro)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:neocities": "node scripts/check-neocities.mjs",
    "deploy:neocities": "npm run build && npm run check:neocities && neocities push dist",
    "assets": "node scripts/make-assets.mjs"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.4"
  },
  "devDependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "js-yaml": "^5.4.2",
    "satori": "^0.33.5",
    "sharp": "^0.35.4"
  },
  "private": true
}
