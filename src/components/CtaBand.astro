---
/** Centered call to action linking to the contact form (optionally with a topic preselected). */
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { company } from '../config/site';
import { pagePath, paragraphs } from '../lib/content';

interface Props {
  lang: Lang;
  heading: string;
  text?: string;
  button?: string;
  topic?: string;
  /** 'sand' on light pages, 'dark' for a deep-green band */
  tone?: 'sand' | 'dark';
}
const { lang, heading, text, button, topic, tone = 'sand' } = Astro.props;
const t = useTranslations(lang);
const href = pagePath('contact', lang) + (topic ? `?topic=${encodeURIComponent(topic)}` : '');
---

<section class:list={['cta', tone === 'dark' ? 'band-dark' : 'band-sand']} aria-labelledby="cta-title">
  <div class="container cta__inner">
    <h2 id="cta-title">{heading}</h2>
    {text && paragraphs(text).map((p) => <p class="cta__text">{p}</p>)}
    <a class="button" href={href}>{button ?? t('common.contact')}</a>
    <p class="cta__mail">
      {t('form.orEmail')} <a href={`mailto:${company.email}`}>{company.email}</a>
    </p>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-2xl);
  }

  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
    text-align: center;
  }

  h2 {
    max-width: 26ch;
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 2.8rem);
  }

  .cta__text {
    max-width: 44ch;
    font-size: var(--step-1);
    color: var(--teras);
  }

  .band-dark .cta__text,
  .band-dark .cta__mail {
    color: var(--on-dark-muted);
  }

  .cta__mail {
    color: var(--teras);
    font-size: var(--step--1);
  }
</style>
