---
/**
 * Faint topographic contour lines – a nod to bedrock maps – used as texture
 * on the dark bands. Generated here, deterministic, purely decorative.
 */
interface Props {
  cx?: number;
  cy?: number;
}
const { cx = 780, cy = 220 } = Astro.props;

const rings = 14;
const paths: string[] = [];
for (let r = 0; r < rings; r++) {
  const base = 40 + r * 38;
  const points: [number, number][] = [];
  const steps = 48;
  for (let i = 0; i < steps; i++) {
    const a = (i / steps) * Math.PI * 2;
    // a few low-frequency wobbles so the rings look like terrain, not circles
    const wobble = 1 + 0.12 * Math.sin(a * 3 + r * 0.5) + 0.07 * Math.sin(a * 5 - r * 0.8) + 0.04 * Math.cos(a * 2 + r);
    points.push([cx + Math.cos(a) * base * 1.35 * wobble, cy + Math.sin(a) * base * wobble]);
  }
  // Catmull-Rom → cubic Bézier for smooth closed curves
  let d = `M${points[0][0].toFixed(1)} ${points[0][1].toFixed(1)}`;
  for (let i = 0; i < steps; i++) {
    const p0 = points[(i - 1 + steps) % steps];
    const p1 = points[i];
    const p2 = points[(i + 1) % steps];
    const p3 = points[(i + 2) % steps];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  paths.push(d + 'Z');
}
---

<svg class="contours" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1">
    {paths.map((d) => <path d={d} />)}
  </g>
</svg>

<style>
  .contours {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--on-dark);
    opacity: 0.07;
    pointer-events: none;
  }
</style>
