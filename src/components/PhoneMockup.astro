---
/**
 * Simple phone with a placeholder ValmiusTurva map screen, drawn in SVG.
 * Replace with real screenshots when the owner provides them (plan §7, ValmiusTurva).
 */
interface Props {
  label: string;
  caption: string;
}
const { label, caption } = Astro.props;
---

<figure class="phone">
  <div class="phone__frame">
    <svg viewBox="0 0 270 560" role="img" aria-label={label}>
      <!-- map -->
      <rect width="270" height="560" fill="#e3e9e4"></rect>
      <path d="M-10 380c60-20 90 10 150-10s110-60 140-50v250H-10z" fill="#cfe0e6"></path>
      <g fill="#d7dfd9">
        <rect x="18" y="96" width="70" height="54" rx="3"></rect>
        <rect x="110" y="84" width="58" height="72" rx="3"></rect>
        <rect x="190" y="104" width="62" height="46" rx="3"></rect>
        <rect x="24" y="176" width="54" height="80" rx="3"></rect>
        <rect x="104" y="186" width="84" height="52" rx="3"></rect>
        <rect x="206" y="176" width="46" height="92" rx="3"></rect>
        <rect x="30" y="280" width="92" height="46" rx="3"></rect>
        <rect x="146" y="262" width="44" height="64" rx="3"></rect>
      </g>
      <g stroke="#fff" stroke-width="9" fill="none" stroke-linecap="round">
        <path d="M-10 166h290M96 60v320M-10 268l290-10M196 60l-6 330"></path>
      </g>
      <!-- route to nearest shelter -->
      <path d="M140 300v-34h54v-92" fill="none" stroke="#2f6b4f" stroke-width="4" stroke-dasharray="2 7" stroke-linecap="round"></path>
      <!-- shelters -->
      <g fill="#2f6b4f">
        <rect x="182" y="150" width="24" height="24" rx="5"></rect>
        <rect x="44" y="198" width="20" height="20" rx="4" opacity="0.75"></rect>
        <rect x="222" y="284" width="20" height="20" rx="4" opacity="0.75"></rect>
      </g>
      <path d="M188 168l6-11 6 11z" fill="#fff"></path>
      <path d="M49 214l5-9 5 9z" fill="#fff"></path>
      <path d="M227 300l5-9 5 9z" fill="#fff"></path>
      <!-- you are here -->
      <circle cx="140" cy="306" r="18" fill="#2a5d8c" opacity="0.15"></circle>
      <circle cx="140" cy="306" r="8" fill="#2a5d8c" stroke="#fff" stroke-width="3"></circle>
      <!-- app bar -->
      <rect width="270" height="64" fill="#2f6b4f"></rect>
      <text x="22" y="42" fill="#fff" font-family="Hanken Grotesk, sans-serif" font-weight="750" font-size="21">ValmiusTurva</text>
      <circle cx="238" cy="34" r="11" fill="none" stroke="#fff" stroke-opacity="0.7" stroke-width="2"></circle>
      <!-- bottom sheet -->
      <rect x="12" y="430" width="246" height="116" rx="14" fill="#f8f9f8"></rect>
      <rect x="28" y="450" width="36" height="36" rx="8" fill="#2f6b4f"></rect>
      <path d="M37 476l9-16 9 16z" fill="#fff"></path>
      <rect x="76" y="454" width="84" height="10" rx="5" fill="#23282c" opacity="0.8"></rect>
      <rect x="76" y="472" width="60" height="8" rx="4" fill="#5e6a72" opacity="0.5"></rect>
      <text x="238" y="466" text-anchor="end" fill="#2f6b4f" font-family="Hanken Grotesk, sans-serif" font-weight="750" font-size="18">350 m</text>
      <rect x="28" y="504" width="214" height="28" rx="6" fill="#2f6b4f" opacity="0.12"></rect>
      <path d="M130 511l10 7-10 7" fill="none" stroke="#2f6b4f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .phone {
    width: min(100%, 17rem);
  }

  .phone__frame {
    padding: 0.55rem;
    border-radius: 2.1rem;
    background: var(--graniitti);
    box-shadow:
      0 1px 0 1px color-mix(in srgb, var(--graniitti) 70%, white) inset,
      0 24px 40px -24px rgb(35 40 44 / 0.45);
  }

  svg {
    width: 100%;
    height: auto;
    border-radius: 1.6rem;
  }

  figcaption {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--teras);
    text-align: center;
  }
</style>
